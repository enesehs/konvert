{
  "app-id": "io.github.enesehs.konvert",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.8",
  "sdk": "org.kde.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "konvert-settings",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--filesystem=host",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/konvert/cargo"
    }
  },
  "modules": [
    {
      "name": "konvert",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release --locked",
        "install -Dm755 target/release/konvert /app/bin/konvert",
        "cmake -B gui/build -S gui -GNinja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/app",
        "ninja -C gui/build",
        "install -Dm755 gui/build/konvert-settings /app/bin/konvert-settings",
        "install -Dm644 io.github.enesehs.konvert.desktop /app/share/applications/io.github.enesehs.konvert.desktop",
        "install -Dm644 packaging/io.github.enesehs.konvert.metainfo.xml /app/share/metainfo/io.github.enesehs.konvert.metainfo.xml",
        "install -Dm644 assets/logo.svg /app/share/icons/hicolor/scalable/apps/io.github.enesehs.konvert.svg",
        "install -Dm644 assets/logo.svg /app/share/icons/hicolor/scalable/apps/konvert.svg",
        "install -Dm644 assets/icons/*.svg -t /app/share/icons/hicolor/scalable/actions/"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/enesehs/konvert.git",
          "tag": "v0.2.0"
        }
      ]
    }
  ]
}
